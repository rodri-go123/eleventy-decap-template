---
tags: [project]
layout: _layouts/header_footer.njk
css:
  - /styles/_project_page.css
---

<div class="project-page-container main-section full-width">
  {# head #}
  <div id="project-head" class="full-width">
    <div class="pr-page-pic-wrapper"><img class="pr-page-pic" src="{{thumbnail | toWebp}}" alt="{{ imageAlt }}"></div>
    <div class="project-page-wrapper flex-center full-width">

      <div class="pr-head-info full-width">
        <h1 class="pr-page-title">{{ title }}</h1>
        <h2 class="pr-page-subtitle">{{ subtitle }}</h2>
        <p class="pr-page-info">{{ info }}, {{year}}</p>
        {% set cleanUrl = page.url | replace('^/', '') %}
        {% set lookupKey = page.url.slice(1) ~ 'index.html' %}
      </div>
    </div>
  </div>

  {# body #}
  <div class="project-page-wrapper">
    <div class="project-body full-width">
      {{ content | safe }}
    </div>
  </div>

</div>