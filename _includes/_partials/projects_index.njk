<div id="projects-container" class="lp-slideshow" aria-label="Project slideshow" tabindex="0">
  <div class="lp-slides">
    {% for project in collections.project | sort(true, false, "date") %}
      {% include "_partials/slideshow_pr_card.njk" %}
    {% endfor %}
  </div>
  <div class="lp-slideshow-controls" aria-label="Slideshow controls">
    <button class="lp-slideshow-button lp-slideshow-button--previous" type="button" aria-label="Previous project">
      <span aria-hidden="true">◣</span>
    </button>
    <button class="lp-slideshow-button lp-slideshow-button--next" type="button" aria-label="Next project">
      <span aria-hidden="true">◣</span>
    </button>
  </div>
  <div class="lp-slideshow-status" aria-live="polite"></div>
</div>

<script type="module" src="/scripts/slideshow.js"></script>