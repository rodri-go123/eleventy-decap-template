---
css:
  - /styles/_header.css
  - /styles/application.css
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="author" content=" ">
    <meta name="description" content=" ">
    <meta name="keywords" content=" ">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    {% if css %}
      {% for sheet in css %}
        <link rel="stylesheet" href="{{ sheet }}">
      {% endfor %}
    {% endif %}
    
  </head>

  <body>

    {# header #}
    <header id="navbar" class="flex-center">
      <div class="nav-wrapper full-width">

        <div class="nav-left flex-center">
          <h1 class="nav-header"><a href="/">{{ site.title }}</a></h1>
        </div>

        <div class="nav-right flex-center">
          {% for item in site.nav %}
            <a href="{{ item.url }}" class="nav-btn {% if page.url == item.url %}active{% endif %}">
              {{ item.label }}
            </a>
          {% endfor %}
        </div>

      </div>
    </header>

    {# body #}
    <div id="main" class="flex-center">
      {{ content | safe }}
    </div>

  </body>
</html>